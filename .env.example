# Copy to .env and fill in what you need -- .env is gitignored and is
# loaded automatically on startup (see modelmaker/api.py). Anything left
# unset here can still be entered later from the Settings panel, or
# exported as a real environment variable (which takes precedence over
# .env). See the "LLM provider" section of README.md for details.

# Which provider to use by default (claude_cli, anthropic, openai, gemini,
# lmstudio, stub). Can also be changed from Settings.
# MODELMAKER_LLM_PROVIDER=anthropic

# Anthropic API (provider: anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API / OpenAI-compatible endpoint (provider: openai)
# OPENAI_API_KEY=sk-...
# MODELMAKER_OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API (provider: gemini)
# GEMINI_API_KEY=...

# LM Studio (provider: lmstudio)
# MODELMAKER_LLM_BASE_URL=http://localhost:1234/v1

# Model id (all providers except lmstudio/claude_cli require this)
# MODELMAKER_LLM_MODEL=gpt-5.1

# Include Polars reference examples in drafting prompts (default on)
# MODELMAKER_LLM_INCLUDE_REFERENCE=true
